# JWT signing secret — must be at least 32 characters (server will refuse to start if shorter)
JWT_SECRET=
COOKIE_SECURE=
COOKIE_SAMESITE=

# Database
DB_HOST=
DB_NAME=
DB_PORT=
DB_USER=
DB_PASS=

# S3 / object storage
AWS_S3_ENDPOINT=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_INSECURE_TLS=
# Public base URL for S3 objects returned in API responses (e.g. https://storage.example.com)
S3_ADDRESS=

# ML service
ML_SERVICE_URL=
# Shared secret for Go→ML internal PATCH calls (X-Internal-Token header)
ML_INTERNAL_TOKEN=

# VK OAuth
VK_CLIENT_ID=

# Auth gRPC (consumed by cmd/main; points at cmd/auth binary)
AUTH_SERVICE_HOST=
AUTH_SERVICE_PORT=

# Notifications gRPC — connection from cmd/main to cmd/notifications
NOTIFICATIONS_HOST=
NOTIFICATIONS_PORT=5460
# Listen address for the notifications gRPC server itself (cmd/notifications binary)
NOTIFICATIONS_ADDR=:5460

# CORS
CORS_ALLOWED_ORIGINS=

# gRPC mutual TLS certs (paths to PEM files)
GRPC_TLS_CA=
GRPC_TLS_CERT=
GRPC_TLS_KEY=

# Kafka
KAFKA_BROKERS=kafka:29092

# Redis (used by leaderboard, rate limiter, SSE pub/sub, recommendation cache, bot notifier, streak worker)
REDIS_ADDR=redis:6379

# Telegram bot integration
# Shared secret checked by /bot/* endpoints (X-Bot-Secret header)
BOT_SECRET=
# Telegram bot token — used by TelegramBot Python service, not Go
USER_BOT_TOKEN=

# Admin endpoints
# Token checked by GET /admin/top-cache-clear (X-Admin-Token header)
ADMIN_TOKEN=

# Prometheus metrics server (default: 9091)
METRICS_PORT=9091

# User video cleanup worker
# How long uploaded user videos are kept in S3 before deletion (default: 24)
USER_VIDEO_TTL_HOURS=24
# How often the cleanup job runs in minutes (default: 60)
USER_VIDEO_CLEANUP_PERIOD_MINUTES=60